  "questions": [
    {
      "id": "MB-001",
      "slug": "ordem-operacoes-24-3",
      "topic_id": "topic-arithmetic",
      "source_id": "src-prealgebra-ch1",
      "source_locator": "Capítulo 1, Review Exercises, exercício 388",
      "statement_md": "Calcule \\(24 \\div 3 + 4(5-2)\\).",
      "question_type": "numeric",
      "difficulty": 1,
      "answer": {"value": 20},
      "hint_md": "Resolva primeiro o que está entre parênteses.",
      "solution_md": "\\(5-2=3\\). Depois, \\(24\\div3=8\\) e \\(4\\cdot3=12\\). Portanto, \\(8+12=20\\).",
      "adaptation_note": "Tradução para o português e adaptação de notação do exercício indicado.",
      "status": "published",
      "estimated_minutes": 2,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-002",
      "slug": "fatoracao-prima-252",
      "topic_id": "topic-arithmetic",
      "source_id": "src-prealgebra-ch1",
      "source_locator": "Capítulo 1, Review Exercises, exercício 386",
      "statement_md": "Determine a fatoração em números primos de \\(252\\).",
      "question_type": "short_text",
      "difficulty": 1,
      "answer": {"latex": "2^2\\cdot3^2\\cdot7"},
      "hint_md": "Comece dividindo sucessivamente por 2 e depois por 3.",
      "solution_md": "\\(252=2\\cdot126=2^2\\cdot63=2^2\\cdot3^2\\cdot7\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 3,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-003",
      "slug": "reduzir-termos-semelhantes",
      "topic_id": "topic-expressions",
      "source_id": "src-prealgebra-ch1",
      "source_locator": "Capítulo 1, Review Exercises, exercício 393",
      "statement_md": "Reduza os termos semelhantes em \\(14x^2-9x+11-8x^2+8x-6\\).",
      "question_type": "short_text",
      "difficulty": 1,
      "answer": {"latex": "6x^2-x+5"},
      "hint_md": "Agrupe separadamente os termos em \\(x^2\\), em \\(x\\) e os termos constantes.",
      "solution_md": "\\((14-8)x^2+(-9+8)x+(11-6)=6x^2-x+5\\).",
      "adaptation_note": "Tradução para o português e adaptação de notação do exercício indicado.",
      "status": "published",
      "estimated_minutes": 3,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-004",
      "slug": "equacao-linear-5x-2",
      "topic_id": "topic-equations",
      "source_id": "src-college-algebra-ch2",
      "source_locator": "Capítulo 2, Review Exercises, exercício 12",
      "statement_md": "Resolva a equação \\(5x+2=7x-8\\).",
      "question_type": "numeric",
      "difficulty": 1,
      "answer": {"value": 5},
      "hint_md": "Reúna os termos com \\(x\\) em um lado e as constantes no outro.",
      "solution_md": "\\(5x+2=7x-8\\Rightarrow10=2x\\Rightarrow x=5\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 3,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-005",
      "slug": "distancia-entre-dois-pontos",
      "topic_id": "topic-analytic-geometry",
      "source_id": "src-college-algebra-ch2",
      "source_locator": "Capítulo 2, Review Exercises, exercício 5",
      "statement_md": "Calcule a distância entre os pontos \\((-2,5)\\) e \\((4,-1)\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"latex": "6\\sqrt{2}"},
      "hint_md": "Use \\(d=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2}\\).",
      "solution_md": "\\(d=\\sqrt{(4+2)^2+(-1-5)^2}=\\sqrt{36+36}=6\\sqrt2\\).",
      "adaptation_note": "Tradução para o português e adaptação de apresentação do exercício indicado.",
      "status": "published",
      "estimated_minutes": 4,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-006",
      "slug": "fatorar-trinomio-x2-3x-10",
      "topic_id": "topic-expressions",
      "source_id": "src-intermediate-algebra-ch6",
      "source_locator": "Capítulo 6, Review Exercises, exercício 358",
      "statement_md": "Fatore completamente \\(x^2-3x-10\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"latex": "(x-5)(x+2)"},
      "hint_md": "Procure dois números cujo produto seja \\(-10\\) e cuja soma seja \\(-3\\).",
      "solution_md": "Os números são \\(-5\\) e \\(2\\). Logo, \\(x^2-3x-10=(x-5)(x+2)\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 4,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-007",
      "slug": "sistema-linear-substituicao",
      "topic_id": "topic-equations",
      "source_id": "src-college-algebra-ch7",
      "source_locator": "Capítulo 7, Review Exercises, exercício 3",
      "statement_md": "Resolva o sistema \\(10x+5y=-5\\) e \\(3x-2y=-12\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"x": -2, "y": 3},
      "hint_md": "Divida a primeira equação por 5 e isole \\(y\\).",
      "solution_md": "Da primeira equação, \\(2x+y=-1\\), então \\(y=-1-2x\\). Substituindo: \\(3x-2(-1-2x)=-12\\), logo \\(7x=-14\\), \\(x=-2\\) e \\(y=3\\).",
      "adaptation_note": "Tradução para o português e conversão do formato matricial do exercício indicado.",
      "status": "published",
      "estimated_minutes": 6,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "MB-008",
      "slug": "equacao-quadratica-fatoracao",
      "topic_id": "topic-equations",
      "source_id": "src-college-algebra-ch2",
      "source_locator": "Capítulo 2, Review Exercises, exercício 40",
      "statement_md": "Resolva por fatoração a equação \\(2x^2-7x-4=0\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"values": [-0.5, 4]},
      "hint_md": "Fatore o trinômio como \\((2x+1)(x-4)\\).",
      "solution_md": "\\(2x^2-7x-4=(2x+1)(x-4)\\). Assim, \\(2x+1=0\\) ou \\(x-4=0\\), resultando em \\(x=-\\frac12\\) ou \\(x=4\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 5,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "PC-001",
      "slug": "relacao-representa-funcao",
      "topic_id": "topic-functions",
      "source_id": "src-precalculus-functions",
      "source_locator": "Seção 1.1, exercícios, exercício 62",
      "statement_md": "A relação \\(\\{(2,5),(7,11),(15,8),(7,9)\\}\\) representa uma função?",
      "question_type": "multiple_choice",
      "difficulty": 1,
      "answer": {"choice": "B"},
      "choices": [
        {"label": "A", "content_md": "Sim, porque todos os pares são diferentes.", "is_correct": false},
        {"label": "B", "content_md": "Não, porque a entrada 7 possui duas saídas.", "is_correct": true},
        {"label": "C", "content_md": "Sim, porque os valores de saída podem se repetir.", "is_correct": false}
      ],
      "hint_md": "Verifique se alguma entrada está associada a mais de uma saída.",
      "solution_md": "A entrada \\(7\\) aparece associada a \\(11\\) e a \\(9\\). Portanto, a relação não satisfaz a definição de função.",
      "adaptation_note": "Tradução para o português e inclusão de alternativas com base no exercício indicado.",
      "status": "published",
      "estimated_minutes": 2,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "PC-002",
      "slug": "avaliar-funcao-cinco-valores",
      "topic_id": "topic-functions",
      "source_id": "src-precalculus-functions",
      "source_locator": "Seção 1.1, exercícios, exercício 68",
      "statement_md": "Para \\(f(x)=4-2x\\), calcule \\(f(-2),f(-1),f(0),f(1)\\) e \\(f(2)\\).",
      "question_type": "short_text",
      "difficulty": 1,
      "answer": {"values": [8, 6, 4, 2, 0]},
      "hint_md": "Substitua cada valor de \\(x\\) na expressão da função.",
      "solution_md": "As substituições fornecem, na ordem solicitada, \\(8,6,4,2,0\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 4,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "PC-003",
      "slug": "reta-por-dois-pontos",
      "topic_id": "topic-linear",
      "source_id": "src-precalculus-linear",
      "source_locator": "Capítulo 2, Review Exercises, exercício 5",
      "statement_md": "Determine a equação da reta que passa por \\((7,5)\\) e \\((3,17)\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"latex": "y=-3x+26"},
      "hint_md": "Comece calculando a inclinação com os dois pontos.",
      "solution_md": "\\(m=(17-5)/(3-7)=-3\\). Usando \\((7,5)\\), temos \\(y-5=-3(x-7)\\), portanto \\(y=-3x+26\\).",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 5,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "PC-004",
      "slug": "dominio-funcao-racional",
      "topic_id": "topic-rational",
      "source_id": "src-precalculus-rational",
      "source_locator": "Seção 3.7, exercícios, exercício 8",
      "statement_md": "Determine o domínio de \\(f(x)=\\frac{x^2+4}{x^2-2x-8}\\).",
      "question_type": "short_text",
      "difficulty": 2,
      "answer": {"latex": "\\mathbb{R}\\setminus\\{-2,4\\}"},
      "hint_md": "Encontre os valores que anulam o denominador.",
      "solution_md": "\\(x^2-2x-8=(x-4)(x+2)\\). O denominador é zero em \\(x=4\\) e \\(x=-2\\); esses valores são excluídos do domínio.",
      "adaptation_note": "Tradução para o português do exercício indicado.",
      "status": "published",
      "estimated_minutes": 4,
      "created_at": "2026-09-24",
      "updated_at": "2026-09-24"
    },
    {
      "id": "PC-005",
      "slug": "composicao-f-de-g-em-2",
      "topic_id": "topic-composition",
